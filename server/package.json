{
  "name": "restaurant-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run seed && tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/seed.js && node dist/main.js",
    "seed": "tsx src/seed.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.1",
    "mongodb-memory-server": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
